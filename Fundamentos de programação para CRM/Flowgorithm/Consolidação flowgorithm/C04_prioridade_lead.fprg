    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orcamento" type="Real" array="False" size=""/>
            <declare name="interesse" type="Integer" array="False" size=""/>
            <output expression="&quot;Qual seu or&#231;amento?&quot;" newline="True"/>
            <input variable="orcamento"/>
            <output expression="&quot;Qual sua pontua&#231;&#227;o de interesse? 0 a 100&quot;" newline="True"/>
            <input variable="interesse"/>
            <if expression="orcamento &gt;= 5000 and interesse &gt;=70">
                <then>
                    <output expression="&quot;Quente&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="orcamento &gt;= 5000 or interesse &gt;= 70">
                        <then>
                            <output expression="&quot;Morno&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Frio&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
