<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="C03_validar_lead"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 04:55:19 PM"/>
