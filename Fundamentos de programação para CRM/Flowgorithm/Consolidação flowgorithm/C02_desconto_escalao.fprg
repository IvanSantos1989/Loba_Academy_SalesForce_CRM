<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="C02_desconto_escalao"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 04:50:35 PM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTA7MDQ6MTI6MDAgUE07Mjg4MA=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTA7MDQ6NTA6MzUgUE07NDszMDAx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="proposta, valorDesconto" type="Real" array="False" size=""/>
            <output expression="&quot;Qual o valor da proposta?&quot;" newline="True"/>
            <input variable="proposta"/>
            <if expression="proposta &gt;= 10000">
                <then>
                    <assign variable="valorDesconto" expression="proposta - (proposta * 0.15)"/>
                    <output expression="&quot;O Valor com desconto &#233; &quot; &amp; valorDesconto" newline="True"/>
                </then>
                <else>
                    <if expression="proposta &gt;= 5000">
                        <then>
                            <assign variable="valorDesconto" expression="proposta - (proposta * 0.10)"/>
                            <output expression="&quot;O Valor com desconto &#233; &quot; &amp; valorDesconto" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;O valor da proposta &#233;: &quot; &amp; proposta &amp; &quot; e n&#227;o tem desconto&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
