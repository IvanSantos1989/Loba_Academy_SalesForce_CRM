    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor, comissao, valorComissao" type="Real" array="False" size=""/>
            <output expression="&quot;Valor da venda: &quot;" newline="True"/>
            <input variable="valor"/>
            <output expression="&quot;Qual a comiss&#227;o de venda? &quot;" newline="True"/>
            <input variable="comissao"/>
            <assign variable="valorComissao" expression="valor * comissao"/>
            <output expression="&quot;O valor da venda com comiss&#227;o &#233; &quot; &amp; valorComissao" newline="True"/>
        </body>
    </function>
