        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMDQ7IjAyOjM4OjUzICI7MTsyODk3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orc1, orc2" type="Real" array="False" size=""/>
            <output expression="&quot;Or&#231;amento do lead 1: &quot;" newline="True"/>
            <input variable="orc1"/>
            <output expression="&quot;Or&#231;amento do lead 2: &quot;" newline="True"/>
            <input variable="orc2"/>
            <if expression="orc1 &gt; orc2">
                <then>
                    <output expression="&quot;Lead 1&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="orc1 &lt; orc2">
                        <then>
                            <output expression="&quot;Lead 2&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Iguais&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
