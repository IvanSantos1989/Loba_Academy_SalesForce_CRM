    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="regiao" type="String" array="False" size=""/>
            <output expression="&quot;Regi&#227;o do lead: &quot;" newline="True"/>
            <input variable="regiao"/>
            <if expression="regiao == &quot;Norte&quot; or regiao == &quot;Centro&quot; or regiao == &quot;norte&quot; or regiao == &quot;centro&quot;">
                <then>
                    <output expression="&quot;Campanha A&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Campanha B&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
