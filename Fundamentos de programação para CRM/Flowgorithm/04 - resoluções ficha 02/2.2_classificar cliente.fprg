<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2.2_classificar cliente"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 02:59:45 PM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTA7MDI6NTQ6MTEgUE07Mjg4Ng=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTA7MDI6NTk6NDUgUE07MTszMDA2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="total" type="Real" array="False" size=""/>
            <declare name="classificacao" type="String" array="False" size=""/>
            <output expression="&quot;Total gasto pelo cliente: &quot;" newline="True"/>
            <input variable="total"/>
            <if expression="total &gt;= 5000">
                <then>
                    <assign variable="classificacao" expression="&quot;Ouro&quot;"/>
                </then>
                <else>
                    <if expression="total &gt;= 1000">
                        <then>
                            <assign variable="classificacao" expression="&quot;Prata&quot;"/>
                        </then>
                        <else>
                            <assign variable="classificacao" expression="&quot;Bronze&quot;"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Cliente &quot; &amp; classificacao" newline="True"/>
        </body>
    </function>
</flowgorithm>
