<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2.3_elegivel desconto"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 03:12:50 PM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTA7MDM6MDA6MDYgUE07Mjg4Mg=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTA7MDM6MTI6NTAgUE07MTsyOTky"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="antigo" type="Boolean" array="False" size=""/>
            <declare name="valor" type="Real" array="False" size=""/>
            <output expression="&quot;Cliente antigo? (true/false)&quot;" newline="True"/>
            <input variable="antigo"/>
            <output expression="&quot;Valor da compra: &quot;" newline="True"/>
            <input variable="valor"/>
            <if expression="antigo and valor &gt; 100">
                <then>
                    <output expression="&quot;Tem desconto&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Sem desconto&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
