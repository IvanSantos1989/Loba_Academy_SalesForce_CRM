<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="01_numero_secreto"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-04 05:44:34 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMDQ7IjA1OjMzOjU1ICI7Mjc4OQ=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMDQ7IjA1OjQ0OjM0ICI7MTsyODk2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Este fluxograma pede ao utilizador para adivinhar um n&#250;mero fixo. O programa compara cada tentativa com o valor correcto e continua a pedir novos valores at&#233; que o utilizador acerte."/>
            <declare name="numeroSecreto, tentativa" type="Integer" array="False" size=""/>
            <assign variable="numeroSecreto" expression="7"/>
            <output expression="&quot;Tente adivinhar o n&#250;mero: &quot;" newline="True"/>
            <input variable="tentativa"/>
            <while expression="tentativa != numeroSecreto">
                <comment text="O ciclo Enquanto se repete-se enquanto o utilizador n&#227;o acertar o n&#250;mero secreto"/>
                <if expression="tentativa &lt; numeroSecreto">
                    <then>
                        <output expression="&quot;O n&#250;mero secreto &#233; maior&quot;" newline="True"/>
                    </then>
                    <else>
                        <output expression="&quot;O n&#250;mero secreto &#233; menor&quot;" newline="True"/>
                    </else>
                </if>
                <output expression="&quot;Tente novamente!&quot;" newline="True"/>
                <input variable="tentativa"/>
            </while>
            <output expression="&quot;Parab&#233;ns, acertaste!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
