<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="01_slide15"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-04 03:13:24 "/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMDQ7IjEyOjQyOjI1ICI7Mjc4NA=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMDQ7IjAzOjEzOjI0ICI7MzsyODkx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orcamento" type="Real" array="False" size=""/>
            <declare name="prioridade" type="String" array="False" size=""/>
            <declare name="interesse" type="String" array="False" size=""/>
            <output expression="&quot;Or&#231;amento do lead: &quot;" newline="True"/>
            <input variable="orcamento"/>
            <output expression="&quot;Seu interesse &#233; alto, m&#233;dio ou baixo?: &quot;" newline="True"/>
            <input variable="interesse"/>
            <if expression="orcamento &gt;= 10000 And interesse == &quot;alto&quot;">
                <then>
                    <assign variable="prioridade" expression="&quot;Quente&quot;"/>
                </then>
                <else>
                    <if expression="orcamento &gt;= 5000 And interesse == &quot;m&#233;dio&quot;">
                        <then>
                            <assign variable="prioridade" expression="&quot;Morno&quot;"/>
                        </then>
                        <else>
                            <if expression="orcamento &gt; 0 And interesse == &quot;baixo&quot;">
                                <then>
                                    <assign variable="prioridade" expression="&quot;Frio&quot;"/>
                                </then>
                                <else>
                                    <output expression="&quot;Entrada de dados inv&#225;lido&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Prioridade: &quot; &amp; prioridade" newline="True"/>
        </body>
    </function>
</flowgorithm>
