    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orcamento" type="Real" array="False" size=""/>
            <declare name="empresa" type="String" array="False" size=""/>
            <output expression="&quot;or&#231;amento lead: &quot;" newline="True"/>
