<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="2.5 lead com maior prioridade"/>
        <attribute name="authors" value="cesae"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-10 11:36:04 AM"/>
        <attribute name="created" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMTA7MTE6MzI6MjcgQU07Mjg1NQ=="/>
        <attribute name="edited" value="Y2VzYWU7REVTS1RPUC1KQk4zUkZKOzIwMjYtMDgtMTA7MTE6MzY6MDQgQU07MzsyOTY0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orc1, orc2" type="Real" array="False" size=""/>
            <output expression="&quot;or&#231;amento lead 1 &quot;" newline="True"/>
            <input variable="orc1"/>
            <output expression="&quot;or&#231;amento lead 2 &quot;" newline="True"/>
            <input variable="orc2"/>
            <if expression="orc1 &gt; orc2">
                <then>
                    <output expression="&quot;o lead 1 tem maior or&#231;amento&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="orc1 &lt; orc2">
                        <then>
                            <output expression="&quot;o lead 2 tem maior or&#231;amento&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;os dois leads t&#234;m o mesmo or&#231;amento&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
