    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nome" type="String" array="False" size=""/>
            <output expression="&quot;Introduza o seu nome: &quot;" newline="True"/>
            <input variable="nome"/>
            <if expression="nome == &quot;Ivan&quot; Or nome == &quot;Mario&quot;">
                <then>
                    <output expression="&quot;Ol&#225; Professor &quot; &amp; nome" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Ol&#225; &quot; &amp; nome" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
