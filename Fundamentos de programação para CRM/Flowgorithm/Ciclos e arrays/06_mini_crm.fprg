<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="06_mini_crm"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-05 09:50:44 PM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDktMDU7MDk6MTM6MzkgUE07MjkwMw=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDktMDU7MDk6MTM6NDEgUE07MTtpdmFubDtMQVBUT1AtUlE0SjY5TVY7MjAyNi0wOS0wNTswNzozNjozMiBQTTswNV9hcnJheXNfcGFyYWxlbG9zLmZwcmc7ODQxMA=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDktMDU7MDk6NTA6NDQgUE07MjszMDA5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nomes" type="String" array="True" size="5"/>
            <declare name="orcamentos" type="Real" array="True" size="5"/>
            <declare name="lead, nomeMaior" type="String" array="False" size=""/>
            <declare name="orc, media, maior, soma" type="Real" array="False" size=""/>
            <declare name="i, contador" type="Integer" array="False" size=""/>
            <assign variable="contador" expression="0"/>
            <assign variable="maior" expression="0"/>
            <assign variable="soma" expression="0"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Nome do lead &quot;&amp; i+1 &amp;&quot;: &quot;" newline="True"/>
                <input variable="lead"/>
                <assign variable="nomes[i]" expression="lead"/>
                <output expression="&quot;Or&#231;amento do lead &quot; &amp; i+1 &amp;&quot;: &quot;" newline="True"/>
                <input variable="orc"/>
                <assign variable="orcamentos[i]" expression="orc"/>
                <assign variable="soma" expression="soma + orc"/>
                <if expression="orc &gt; maior">
                    <then>
                        <assign variable="maior" expression="orc"/>
                        <assign variable="nomeMaior" expression="lead"/>
                    </then>
                    <else/>
                </if>
            </for>
            <assign variable="media" expression="soma / 5"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="nomes[i] &amp; &quot; - Or&#231;amento: &quot; &amp; orcamentos[i]" newline="True"/>
                <if expression="orcamentos[i] &gt; media">
                    <then>
                        <assign variable="contador" expression="contador + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;M&#233;dia de or&#231;amentos = &quot; &amp; media" newline="True"/>
            <output expression="&quot;Lead com o maior or&#231;amento: &quot; &amp; nomeMaior" newline="True"/>
            <output expression="&quot;Maior or&#231;amento = &quot; &amp; maior" newline="True"/>
            <output expression="&quot;Leads com or&#231;amento acima da m&#233;dia: &quot; &amp; contador" newline="True"/>
        </body>
    </function>
</flowgorithm>
