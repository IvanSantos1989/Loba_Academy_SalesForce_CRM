<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="03_array_maior"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-29 01:09:52 AM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMjk7MTI6MzQ6MjIgQU07Mjg4Mg=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMjk7MDE6MDk6NTIgQU07MTsyOTkz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="orcamentos5" type="Integer" array="True" size="5"/>
            <declare name="total, maior, i" type="Integer" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <assign variable="maior" expression="0"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Or&#231;amento &quot; &amp; i+1 &amp; &quot;: &quot;" newline="True"/>
                <input variable="orcamentos5[i]"/>
                <assign variable="total" expression="total + orcamentos5[i]"/>
                <if expression="orcamentos5[i] &gt; maior">
                    <then>
                        <assign variable="maior" expression="orcamentos5[i]"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Total de or&#231;amentos: &quot; &amp; total" newline="True"/>
            <output expression="&quot;O maior or&#231;amento &#233;: &quot; &amp; maior" newline="True"/>
        </body>
    </function>
</flowgorithm>
