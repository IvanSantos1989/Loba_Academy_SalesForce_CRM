<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="06_slide16a"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-18 09:57:46 AM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MDk6MTA6MjYgQU07Mjg4NA=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MDk6NTc6NDYgQU07MTszMDA1"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="orcamento, total, media" type="Real" array="False" size=""/>
            <assign variable="total" expression="0"/>
            <for variable="i" start="1" end="5" direction="inc" step="1">
                <output expression="&quot;Or&#231;amento &quot; &amp; i &amp; &quot;;&quot;" newline="True"/>
                <input variable="orcamento"/>
                <assign variable="total" expression="total + orcamento"/>
            </for>
            <assign variable="media" expression="total/5"/>
            <output expression="&quot;Total: &quot; &amp; total" newline="True"/>
            <output expression="&quot;M&#233;dia: &quot; &amp; media" newline="True"/>
        </body>
    </function>
</flowgorithm>
