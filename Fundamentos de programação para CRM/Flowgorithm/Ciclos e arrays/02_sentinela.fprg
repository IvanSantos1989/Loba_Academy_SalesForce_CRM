<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="02_sentinela"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-29 12:34:03 AM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MDI6MDQ6MDUgUE07Mjg5Mg=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMjk7MTI6MzQ6MDMgQU07MjsyOTkw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="total, OppContador, orcamento" type="Integer" array="False" size=""/>
            <assign variable="OppContador" expression="0"/>
            <assign variable="total" expression="0"/>
            <output expression="&quot;valor do or&#231;amento: &quot;" newline="True"/>
            <input variable="orcamento"/>
            <while expression="orcamento != 0">
                <assign variable="OppContador" expression="OppContador + 1"/>
                <assign variable="total" expression="total + orcamento"/>
                <output expression="&quot;valor do or&#231;amento: &quot;" newline="True"/>
                <input variable="orcamento"/>
            </while>
            <output expression="&quot;Total de leads: &quot; &amp; OppContador" newline="True"/>
            <output expression="&quot;Total de or&#231;amentos: &quot; &amp; total" newline="True"/>
        </body>
    </function>
</flowgorithm>
