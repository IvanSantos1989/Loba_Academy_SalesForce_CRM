<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="06_slide16c"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-18 11:59:10 AM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MTE6MjQ6MjYgQU07Mjg4Mg=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MTE6NTk6MTAgQU07MzsyOTkz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, posMaior" type="Integer" array="False" size=""/>
            <declare name="nomes" type="String" array="True" size="5"/>
            <declare name="orcamentos" type="Real" array="True" size="5"/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Nome &quot; &amp; i+1 &amp; &quot;:&quot;" newline="True"/>
                <input variable="nomes[i]"/>
                <while expression="nomes[i] == &quot;&quot;">
                    <output expression="&quot;Nome inv&#225;lido&quot;" newline="True"/>
                    <output expression="&quot;Nome &quot; &amp; i+1 &amp; &quot;:&quot;" newline="True"/>
                    <input variable="nomes[i]"/>
                </while>
                <output expression="&quot;Or&#231;amento da empresa &quot; &amp; nomes[i] &amp; &quot;:&quot;" newline="True"/>
                <input variable="orcamentos[i]"/>
                <while expression="orcamentos[i] &lt;= 0">
                    <output expression="&quot;Valor inv&#225;lido. Introduza um valor maior do que 0&quot;" newline="True"/>
                    <output expression="&quot;Or&#231;amento da empresa &quot; &amp; nomes[i] &amp; &quot;:&quot;" newline="True"/>
                    <input variable="orcamentos[i]"/>
                </while>
            </for>
            <assign variable="posMaior" expression="0"/>
            <for variable="i" start="1" end="4" direction="inc" step="1">
                <if expression="orcamentos[i] &gt; orcamentos[posMaior]">
                    <then>
                        <assign variable="posMaior" expression="i"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Lead com maior or&#231;amento &#233; o &quot; &amp; nomes[posMaior] &amp; &quot; e com or&#231;amento de &quot; &amp; orcamentos[posMaior] &amp; &quot; euros.&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
