<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="06_slide16b"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-18 10:46:38 AM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MDk6NTg6MzQgQU07Mjg5NQ=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDgtMTg7MTA6NDY6MzggQU07MTsyOTk2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="orcamentos" type="Real" array="True" size="5"/>
            <declare name="maior" type="Real" array="False" size=""/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Or&#231;amento &quot; &amp; i+1 &amp; &quot;:&quot;" newline="True"/>
                <input variable="orcamentos[i]"/>
                <while expression="orcamentos[i] &lt;= 0">
                    <output expression="&quot;Valor inv&#225;lido! Introduza um valor maior que 0!&quot;" newline="True"/>
                    <output expression="&quot;Or&#231;amento &quot; &amp; i+1 &amp; &quot;:&quot;" newline="True"/>
                    <input variable="orcamentos[i]"/>
                </while>
            </for>
            <assign variable="maior" expression="orcamentos[0]"/>
            <for variable="i" start="1" end="4" direction="inc" step="1">
                <if expression="orcamentos[i] &gt; maior">
                    <then>
                        <assign variable="maior" expression="orcamentos[i]"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;Maior: &quot; &amp; maior" newline="True"/>
        </body>
    </function>
</flowgorithm>
