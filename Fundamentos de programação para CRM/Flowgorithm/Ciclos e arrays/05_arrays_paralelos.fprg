<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="05_arrays_paralelos"/>
        <attribute name="authors" value="ivanl"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-05 08:45:52 PM"/>
        <attribute name="created" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDktMDU7MDc6MzY6MzIgUE07Mjg5OQ=="/>
        <attribute name="edited" value="aXZhbmw7TEFQVE9QLVJRNEo2OU1WOzIwMjYtMDktMDU7MDg6NDU6NTIgUE07MzszMDEy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nomes" type="String" array="True" size="5"/>
            <declare name="orcamentos" type="Real" array="True" size="5"/>
            <declare name="lead" type="String" array="False" size=""/>
            <declare name="orc" type="Real" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="&quot;Nome do lead &quot;&amp; i+1 &amp;&quot;: &quot;" newline="True"/>
                <input variable="lead"/>
                <assign variable="nomes[i]" expression="lead"/>
                <output expression="&quot;Or&#231;amento do lead &quot; &amp; i+1 &amp;&quot;: &quot;" newline="True"/>
                <input variable="orc"/>
                <assign variable="orcamentos[i]" expression="orc"/>
            </for>
            <for variable="i" start="0" end="4" direction="inc" step="1">
                <output expression="nomes[i] &amp; &quot; - Or&#231;amento: &quot; &amp; orcamentos[i]" newline="True"/>
            </for>
        </body>
    </function>
</flowgorithm>
