<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>67.0</apiVersion>

    <!-- Permite que o componente apareça no Lightning App Builder -->
    <isExposed>true</isExposed>

    <masterLabel>NexTech Deal Health</masterLabel>

    <description>
        Analisa a qualidade dos dados de uma oportunidade e apresenta um Deal Health Score.
    </description>

    <targets>
        <target>lightning__RecordPage</target>
    </targets>

    <!-- O componente só pode ser usado em páginas de Opportunity -->
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Opportunity</object>
            </objects>
        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>